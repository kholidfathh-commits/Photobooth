# ============================================================
# Street Photobooth — contoh pengaturan. Salin ke .env.local (lokal) atau
# isi di Vercel → Settings → Environment Variables. JANGAN commit nilai asli.
# ============================================================

# --- Database ---
# Lokal: file SQLite. Produksi: Turso. Integrasi Turso di Vercel mengisi
# TURSO_DATABASE_URL & TURSO_AUTH_TOKEN otomatis (keduanya didukung).
DATABASE_URL=file:./data/photobooth.db
DATABASE_AUTH_TOKEN=

# --- Penyimpanan foto ---
# Vercel Blob: diisi otomatis saat store Blob disambungkan di Vercel.
# Dipakai bila kredensial Google Drive di bawah kosong.
BLOB_READ_WRITE_TOKEN=

# --- Alamat publik ---
# Domain aplikasi untuk tautan unduh & QR, mis. https://photobooth-kamu.vercel.app
# (kosongkan saat lokal).
NEXT_PUBLIC_APP_URL=

# --- Google Drive (hanya server) ---
# Gmail biasa (disarankan): isi tiga nilai OAuth di bawah.
# Refresh token didapat dengan: npm run drive:token
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Opsional: id folder tujuan. Kosong = folder "Street Photobooth" dibuat otomatis.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Alternatif Google Workspace: Service Account (folder wajib di Shared Drive).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Isi "tiruan" untuk memaksa Drive tiruan lokal (pengembangan saja).
GOOGLE_DRIVE_MODE=

# --- Keamanan ---
# Token untuk mengubah pengaturan acara lewat API (wajib di produksi).
OPERATOR_TOKEN=
# Rahasia cron Vercel (/api/uploads/retry, /api/maintenance/cleanup).
CRON_SECRET=

# --- Lain-lain (opsional) ---
# Zona waktu acara untuk nama berkas & folder tanggal di Drive.
EVENT_TIME_ZONE=Asia/Jakarta
# Folder berkas sementara di server (bawaan: ./data/files, atau /tmp di Vercel).
STORAGE_DIR=
# Mode demo: "tiruan" = tanpa kamera / tanpa unggah sungguhan.
NEXT_PUBLIC_CAMERA_MODE=
NEXT_PUBLIC_UPLOAD_MODE=
