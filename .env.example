# Database: file SQLite lokal (default) atau URL Turso/libSQL untuk produksi.
DATABASE_URL=file:./data/photobooth.db
# Hanya diperlukan untuk Turso.
DATABASE_AUTH_TOKEN=

# Domain publik untuk tautan unduhan & QR (kosongkan saat lokal).
NEXT_PUBLIC_APP_URL=

# Folder penyimpanan berkas sementara di server (default ./data/files).
STORAGE_DIR=

# Zona waktu acara untuk nama berkas & folder tanggal di Drive.
EVENT_TIME_ZONE=Asia/Jakarta

# --- Google Drive (hanya server; jangan pakai awalan NEXT_PUBLIC_) ---
# Folder tujuan semua hasil foto (id dari URL folder Drive).
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Pilihan 1: Service Account (folder harus di Shared Drive / dibagikan ke email ini).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Tempel private key dalam satu baris; baris baru ditulis sebagai \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Pilihan 2: OAuth akun Google biasa (memakai kuota Drive akun tersebut).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Isi "tiruan" untuk memaksa Drive tiruan lokal (pengembangan).
GOOGLE_DRIVE_MODE=

# Rahasia untuk endpoint cron /api/uploads/retry (kosong = tanpa pengecekan, hanya untuk lokal).
CRON_SECRET=

# Token operator untuk mengubah pengaturan acara (wajib di produksi).
OPERATOR_TOKEN=
